# Copy this file to .env and fill it in. .env is ignored by git, so addresses and keys stay out of the repository.

# Server with an OpenAI-compatible API. It serves chat (/api/llm/v1), web search (/api/search)
# and embeddings (/api/embeddings).
OPENAI_COMPATIBLE_API=http://localhost:8080

LLM_MODEL=swift-1.5-27b-xxs
LLM_API_KEY=not-needed
# LLM_BASE_URL=https://api.example.com/v1   only when chat runs on a different server

# Optional, free keys: without them both services rate-limit quickly and are skipped (logged)
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
